#!/usr/bin/env python3
"""
BlueTeam Linux Enterprise - System Daemon
Real-time security monitoring and threat detection
"""

import sys
import os
import signal
import logging
import json
import asyncio
from pathlib import Path
from datetime import datetime
from typing import Optional

# Add lib to path
sys.path.insert(0, '/usr/lib/blueteam')

from backend.system_monitor import SystemMonitor, ThreatLevel
from ml.threat_detection import (
    NetworkAnomalyDetector,
    ProcessAnomalyDetector,
    ThreatClassifier,
    BehavioralAnalyzer
)


class BlueTeamDaemon:
    """BlueTeam Enterprise Daemon"""
    
    def __init__(self):
        self.config_dir = Path("/etc/blueteam")
        self.log_dir = Path("/var/log/blueteam")
        self.data_dir = Path("/var/lib/blueteam")
        self.pid_file = Path("/var/run/blueteam.pid")
        
        # Create directories if they don't exist
        self.log_dir.mkdir(parents=True, exist_ok=True)
        self.data_dir.mkdir(parents=True, exist_ok=True)
        
        # Setup logging
        self.logger = self._setup_logging()
        
        # Initialize components
        self.monitor = SystemMonitor()
        self.network_detector = NetworkAnomalyDetector()
        self.process_detector = ProcessAnomalyDetector()
        self.threat_classifier = ThreatClassifier()
        self.behavioral_analyzer = BehavioralAnalyzer()
        
        self.running = False
        
    def _setup_logging(self) -> logging.Logger:
        """Setup logging"""
        
        logger = logging.getLogger('blueteam')
        logger.setLevel(logging.DEBUG)
        
        # File handler
        fh = logging.FileHandler(self.log_dir / 'daemon.log')
        fh.setLevel(logging.DEBUG)
        
        # Console handler
        ch = logging.StreamHandler()
        ch.setLevel(logging.INFO)
        
        # Formatter
        formatter = logging.Formatter(
            '%(asctime)s - %(name)s - %(levelname)s - %(message)s'
        )
        fh.setFormatter(formatter)
        ch.setFormatter(formatter)
        
        logger.addHandler(fh)
        logger.addHandler(ch)
        
        return logger
        
    def start(self):
        """Start daemon"""
        
        self.logger.info("Starting BlueTeam Enterprise Daemon")
        self.running = True
        
        # Write PID file
        with open(self.pid_file, 'w') as f:
            f.write(str(os.getpid()))
            
        # Setup signal handlers
        signal.signal(signal.SIGTERM, self._handle_signal)
        signal.signal(signal.SIGINT, self._handle_signal)
        
        try:
            self._run_monitoring_loop()
        except Exception as e:
            self.logger.error(f"Daemon error: {e}", exc_info=True)
        finally:
            self.stop()
            
    def _run_monitoring_loop(self):
        """Run main monitoring loop"""
        
        loop = asyncio.new_event_loop()
        asyncio.set_event_loop(loop)
        
        try:
            while self.running:
                loop.run_until_complete(self._monitoring_cycle())
                
        finally:
            loop.close()
            
    async def _monitoring_cycle(self):
        """Single monitoring cycle"""
        
        try:
            # Monitor network
            self.logger.debug("Monitoring network connections...")
            connections = await self.monitor.monitor_network()
            
            for conn in connections:
                # Check for anomalies
                is_anomaly, confidence = self.network_detector.detect_anomaly({
                    "dst_port": conn.dst_port,
                    "dst_ip": conn.dst_ip,
                    "protocol": conn.protocol,
                    "status": conn.status
                })
                
                if is_anomaly and confidence > 0.7:
                    self.logger.warning(
                        f"Network anomaly detected: {conn.process_name} -> "
                        f"{conn.dst_ip}:{conn.dst_port} (confidence: {confidence:.2f})"
                    )
                    
            # Monitor processes
            self.logger.debug("Monitoring processes...")
            processes = await self.monitor.monitor_processes()
            
            for proc in processes:
                is_anomaly, confidence = self.process_detector.detect_anomaly({
                    "process_name": proc.process_name,
                    "user": proc.user,
                    "event_type": proc.event_type,
                    "command_line": proc.command_line
                })
                
                if is_anomaly and confidence > 0.7:
                    self.logger.warning(
                        f"Process anomaly detected: {proc.process_name} "
                        f"(confidence: {confidence:.2f})"
                    )
                    
            # Monitor file access
            self.logger.debug("Monitoring file access...")
            files = await self.monitor.monitor_file_access()
            
            # Monitor system resources
            self.logger.debug("Monitoring system resources...")
            resources = await self.monitor.monitor_system_resources()
            
            # Save threats to database
            self._save_threats()
            
            # Wait before next cycle
            await asyncio.sleep(5)
            
        except Exception as e:
            self.logger.error(f"Monitoring cycle error: {e}", exc_info=True)
            await asyncio.sleep(5)
            
    def _save_threats(self):
        """Save detected threats"""
        
        threats = self.monitor.get_threats()
        
        if threats:
            threat_file = self.data_dir / f"threats_{datetime.now().strftime('%Y%m%d')}.jsonl"
            
            with open(threat_file, 'a') as f:
                for threat in threats[-10:]:  # Save last 10 threats
                    f.write(json.dumps(threat) + '\n')
                    
    def _handle_signal(self, signum, frame):
        """Handle signals"""
        
        self.logger.info(f"Received signal {signum}")
        self.running = False
        
    def stop(self):
        """Stop daemon"""
        
        self.logger.info("Stopping BlueTeam Enterprise Daemon")
        self.running = False
        
        # Remove PID file
        try:
            self.pid_file.unlink()
        except:
            pass
            
        self.logger.info("BlueTeam daemon stopped")


def main():
    """Main entry point"""
    
    daemon = BlueTeamDaemon()
    daemon.start()


if __name__ == "__main__":
    main()
