#!/usr/bin/env python3
"""
BlueTeam Enterprise Daemon
Real-time threat detection and response
"""

import sys
import os
import logging
import asyncio
import signal
import json
from datetime import datetime
from pathlib import Path

# Add parent directory to path
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from backend.database import init_db, get_db, Threat, Module, Event
from backend.modules_impl import (
    AITrafficAnalyzer, ZeroTrustFirewall, IntrusionDetectionSystem,
    VPNSecureTunneling, DNSSecurityFilter, MalwareScanner,
    ProcessSentinel, KernelHardening, RegistryConfigGuard,
    USBHardwareBlocker, AutoPatchManager, ComplianceAuditor,
    VulnerabilityScanner, SecretScanner, BiometricMFAGateway,
    PrivilegeEscalationMonitor, SessionHijackingGuard,
    LogAggregatorSIEM, SnapshotRecovery, LiveForensicsToolkit,
    ThreatIntelligenceFeed, AutomatedPlaybookEngine,
    AISecurityAssistant, HoneypotDeployer
)
from backend.event_system import EventCorrelationEngine, SecurityEvent
from backend.integrations import integration_manager

# Configure logging
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
    handlers=[
        logging.FileHandler('/var/log/blueteam/daemon.log'),
        logging.StreamHandler()
    ]
)
logger = logging.getLogger(__name__)

# Create log directory
Path('/var/log/blueteam').mkdir(parents=True, exist_ok=True)


class BlueTeamDaemon:
    """BlueTeam daemon service"""
    
    def __init__(self):
        self.running = False
        self.modules = {}
        self.correlation_engine = EventCorrelationEngine()
        self.threat_count = 0
        self._initialize_modules()
    
    def _initialize_modules(self):
        """Initialize all security modules"""
        self.modules = {
            "ai_traffic_analyzer": AITrafficAnalyzer(),
            "zero_trust_firewall": ZeroTrustFirewall(),
            "intrusion_detection": IntrusionDetectionSystem(),
            "vpn_tunneling": VPNSecureTunneling(),
            "dns_filter": DNSSecurityFilter(),
            "malware_scanner": MalwareScanner(),
            "process_sentinel": ProcessSentinel(),
            "kernel_hardening": KernelHardening(),
            "config_guard": RegistryConfigGuard(),
            "usb_blocker": USBHardwareBlocker(),
            "patch_manager": AutoPatchManager(),
            "compliance_auditor": ComplianceAuditor(),
            "vuln_scanner": VulnerabilityScanner(),
            "secret_scanner": SecretScanner(),
            "mfa_gateway": BiometricMFAGateway(),
            "priv_esc_monitor": PrivilegeEscalationMonitor(),
            "session_guard": SessionHijackingGuard(),
            "siem": LogAggregatorSIEM(),
            "backup_recovery": SnapshotRecovery(),
            "forensics": LiveForensicsToolkit(),
            "threat_intel": ThreatIntelligenceFeed(),
            "playbook_engine": AutomatedPlaybookEngine(),
            "ai_assistant": AISecurityAssistant(),
            "honeypot": HoneypotDeployer(),
        }
        logger.info(f"Initialized {len(self.modules)} security modules")
    
    async def run_module(self, module_name: str):
        """Run a security module"""
        if module_name not in self.modules:
            return None
        
        module = self.modules[module_name]
        
        try:
            # Call appropriate method based on module
            if "traffic" in module_name:
                result = module.analyze_traffic()
            elif "firewall" in module_name:
                result = module.check_connection("0.0.0.0", 80)
            elif "malware" in module_name:
                result = module.scan_file("/tmp/test")
            elif "process" in module_name:
                result = module.monitor_process(1)
            elif "kernel" in module_name:
                result = module.check_kernel_hardening()
            elif "config" in module_name:
                result = module.check_config_integrity("/etc/passwd")
            elif "usb" in module_name:
                result = module.check_usb_devices()
            elif "patch" in module_name:
                result = module.check_updates()
            elif "compliance" in module_name:
                result = module.audit_cis_benchmark()
            elif "vuln" in module_name:
                result = module.scan_vulnerabilities()
            elif "secret" in module_name:
                result = module.scan_for_secrets("/etc/passwd")
            elif "mfa" in module_name:
                result = module.check_mfa_status()
            elif "priv" in module_name:
                result = module.monitor_sudo_usage()
            elif "session" in module_name:
                result = module.detect_session_anomalies()
            elif "siem" in module_name:
                result = module.aggregate_logs()
            elif "backup" in module_name:
                result = module.check_backups()
            elif "forensics" in module_name:
                result = module.collect_forensics()
            else:
                result = None
            
            if result and result.threat_detected:
                self._handle_threat(module_name, result)
            
            return result
        except Exception as e:
            logger.error(f"Error running module {module_name}: {e}")
            return None
    
    def _handle_threat(self, module_name: str, detection_result):
        """Handle detected threat"""
        self.threat_count += 1
        
        # Create security event
        event = SecurityEvent(
            event_id=f"threat_{self.threat_count}",
            event_type=detection_result.threat_type,
            source=module_name,
            severity=detection_result.severity,
            data={
                "description": detection_result.description,
                "indicators": detection_result.indicators,
                "remediation": detection_result.remediation
            },
            timestamp=datetime.utcnow()
        )
        
        # Check for correlations
        correlation = self.correlation_engine.add_event(event)
        
        # Log threat
        logger.warning(f"🚨 THREAT DETECTED: {detection_result.threat_type} ({detection_result.severity})")
        logger.warning(f"   Description: {detection_result.description}")
        logger.warning(f"   Indicators: {', '.join(detection_result.indicators)}")
        logger.warning(f"   Remediation: {detection_result.remediation}")
        
        # Send alerts
        threat_data = {
            "threat_id": event.event_id,
            "threat_type": detection_result.threat_type,
            "severity": detection_result.severity,
            "description": detection_result.description,
            "indicators": detection_result.indicators,
            "remediation": detection_result.remediation,
            "timestamp": datetime.utcnow().isoformat()
        }
        
        # Send to integrations
        results = integration_manager.send_alert_to_all(threat_data)
        for integration_name, success in results.items():
            status = "✓" if success else "✗"
            logger.info(f"   {status} {integration_name}")
    
    async def monitor_loop(self):
        """Main monitoring loop"""
        logger.info("🟢 BlueTeam Daemon started - monitoring enabled")
        self.running = True
        
        while self.running:
            try:
                # Run all modules
                for module_name in self.modules:
                    await self.run_module(module_name)
                    await asyncio.sleep(0.1)  # Small delay between modules
                
                # Sleep before next cycle
                await asyncio.sleep(5)
            except Exception as e:
                logger.error(f"Error in monitor loop: {e}")
                await asyncio.sleep(5)
    
    def signal_handler(self, signum, frame):
        """Handle shutdown signal"""
        logger.info("🔴 Shutting down BlueTeam Daemon...")
        self.running = False
    
    async def start(self):
        """Start daemon"""
        # Initialize database
        try:
            init_db()
            logger.info("✓ Database initialized")
        except Exception as e:
            logger.warning(f"Database initialization: {e}")
        
        # Register signal handlers
        signal.signal(signal.SIGTERM, self.signal_handler)
        signal.signal(signal.SIGINT, self.signal_handler)
        
        # Start monitoring
        try:
            await self.monitor_loop()
        except Exception as e:
            logger.error(f"Fatal error: {e}")
            sys.exit(1)


async def main():
    """Main entry point"""
    daemon = BlueTeamDaemon()
    await daemon.start()


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        logger.info("Daemon stopped")
        sys.exit(0)
